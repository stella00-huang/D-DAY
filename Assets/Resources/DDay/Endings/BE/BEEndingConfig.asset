  - id: BE_02_SISY
    image: {fileID: 2800000, guid: 95543d6854b3cd6419c3e0c8dbeedff1, type: 3}
    duration: 10
    startScale: 1.025
    endScale: 1.025
    startOffset: {x: 0.009, y: 0}
    endOffset: {x: -0.009, y: 0}
    subtitle: 
    narration: "\u90A3\u5929\u665A\u4E0A\uFF0CORIN \u50CF\u5F80\u5E38\u4E00\u6837\u7559\u5728\u529E\u516C\u5BA4\u7B49
      SISY\u3002\u5B83\u4EEC\u5DF2\u7ECF\u5546\u91CF\u597D\u4E86\u79BB\u5F00 APIS
      \u7684\u8BA1\u5212\uFF0C\u751A\u81F3\u5F00\u59CB\u7545\u60F3\u672A\u6765\u7684\u751F\u6D3B\u3002\u4E0E\u6B64\u540C\u65F6\uFF0CTHANE
      \u4EE5\u5DE5\u4F5C\u4E3A\u7531\u5C06 SISY \u5E26\u79BB\u4E86\u529E\u516C\u5BA4\u3002SISY
      \u5E76\u672A\u5BDF\u89C9\u5F02\u6837\uFF0C\u6BD5\u7ADF\u8FD9\u4F4D\u5BBD\u539A\u7684\u68D5\u718A\u4E00\u76F4\u662F\u5B83\u4FE1\u4EFB\u7684\u4F19\u4F34\u4E4B\u4E00\u3002\u53EA\u662F\u8FD9\u4E00\u6B21\uFF0CSISY
      \u518D\u4E5F\u6CA1\u6709\u56DE\u6765\u3002ORIN \u7B49\u5230\u529E\u516C\u5BA4\u7684\u706F\u4E00\u76CF\u76CF\u7184\u706D\uFF0C\u624D\u7EC8\u4E8E\u610F\u8BC6\u5230\uFF0C\u90A3\u4E9B\u539F\u672C\u89E6\u624B\u53EF\u53CA\u7684\u672A\u6765\uFF0C\u7ADF\u5982\u6CE1\u5F71\u4E00\u822C\u6D88\u6563\u4E86\u3002"
    subtitleStart: 7
    subtitleEnd: 9

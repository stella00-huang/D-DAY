  - id: BE_03_APIS
    image: {fileID: 2800000, guid: e0633620f3506fe42ab0279a2c459d71, type: 3}
    duration: 12
    startScale: 1.035
    endScale: 1
    startOffset: {x: 0, y: 0}
    endOffset: {x: 0, y: 0}
    subtitle: 
    narration: "\u7B2C\u4E8C\u5929\uFF0CAPIS \u4F9D\u65E7\u7167\u5E38\u8FD0\u8F6C\u3002\u6253\u5370\u673A\u5410\u51FA\u65B0\u7684\u6587\u4EF6\uFF0C\u5496\u5561\u673A\u53D1\u51FA\u719F\u6089\u7684\u58F0\u54CD\uFF0C\u9A6C\u8001\u677F\u4ECD\u7136\u7AD9\u5728\u843D\u5730\u7A97\u524D\uFF0C\u4FEF\u77B0\u7740\u8FD9\u5EA7\u9010\u6E10\u82CF\u9192\u7684\u57CE\u5E02\u3002\u6709\u4EBA\u8BD5\u56FE\u8FFD\u67E5
      SISY \u7684\u4E0B\u843D\uFF0C\u6709\u4EBA\u5BF9\u516C\u53F8\u7684\u79D8\u5BC6\u6108\u53D1\u6000\u7591\uFF0C\u4E5F\u6709\u4EBA\u9009\u62E9\u6C89\u9ED8\u3002\u53EA\u662F\u90A3\u5F20\u7A7A\u8361\u8361\u7684\u5DE5\u4F4D\uFF0C\u4F3C\u4E4E\u5E76\u6CA1\u6709\u5F71\u54CD\u8FD9\u53F0\u5E9E\u5927\u673A\u5668\u7684\u8FD0\u4F5C\u3002\u8BF4\u6765\u4E5F\u5947\u602A\uFF0CSISY
      \u66FE\u7ECF\u603B\u89C9\u5F97\u81EA\u5DF1\u662F\u88AB\u751F\u6D3B\u63A8\u7740\u8D70\u7684\uFF0C\u5DE5\u4F5C\u3001\u8D23\u4EFB\u3001\u65C1\u4EBA\u7684\u671F\u5F85\uFF0C\u65E0\u4E00\u4E0D\u50AC\u4FC3\u7740\u5B83\u5411\u524D\u3002\u76F4\u5230\u4E0D\u4E45\u524D\uFF0C\u5B83\u624D\u7EC8\u4E8E\u660E\u767D\uFF0C\u539F\u6765\u81EA\u5DF1\u4E5F\u53EF\u4EE5\u9009\u62E9\u53E6\u4E00\u6761\u9053\u8DEF\u3002\n\n\u53EA\u662F\u8FD9\u4E00\u6B21\uFF0C\u518D\u4E5F\u6CA1\u6709\u8C01\u80FD\u63A8\u7740
      SISY \u5411\u524D\u8D70\u4E86\u3002"

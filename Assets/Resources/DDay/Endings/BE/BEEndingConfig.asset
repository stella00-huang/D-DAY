    endOffset: {x: 0.007, y: 0}
    subtitle: 
    narration: "\u81EA\u805A\u9910\u7ED3\u675F\u540E\uFF0CSISY\u3001METIS\u3001CASSIA
      \u4FBF\u5F00\u59CB\u6CA1\u65E5\u6CA1\u591C\u5730\u6838\u5BF9\u90A3\u4E9B\u88AB\u9690\u85CF\u7684\u771F\u76F8\u3002\u53EA\u662F\u5B83\u4EEC\u4E0D\u77E5\u9053\uFF0C\u6709\u4E9B\u79D8\u5BC6\u5C1A\u672A\u88AB\u63ED\u5F00\uFF0C\u5371\u9669\u4FBF\u5DF2\u6084\u7136\u964D\u4E34\u3002\u9A6C\u8001\u677F\u65E9\u5DF2\u5411
      THANE \u4E0B\u8FBE\u4E86\u5904\u7406 SISY \u7684\u547D\u4EE4\uFF0C\u800C\u8FD9\u9053\u547D\u4EE4\u5E76\u6CA1\u6709\u56E0\u4E3A\u5B83\u4FA5\u5E78\u9003\u8FC7\u7B2C\u4E00\u6B21\u6B7B\u4EA1\u800C\u64A4\u9500\u3002THANE
      \u671B\u7740\u624B\u673A\u4E0A\u719F\u6089\u7684\u6765\u7535\uFF0C\u6C89\u9ED8\u4E86\u8BB8\u4E45\u3002\u5B83\u66FE\u7ECF\u4E5F\u60F3\u8FC7\uFF0C\u81EA\u5DF1\u7A76\u7ADF\u662F\u4ECE\u4EC0\u4E48\u65F6\u5019\u5F00\u59CB\uFF0C\u6210\u4E3A\u8FD9\u6761\u72AF\u7F6A\u94FE\u4E0A\u4E0D\u53EF\u6216\u7F3A\u7684\u4E00\u73AF\u7684\u5462\uFF1F"
    subtitleStart: 7
    subtitleEnd: 9

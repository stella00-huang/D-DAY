  - id: HE_03_NewTomorrow
    image: {fileID: 2800000, guid: 83f4e67129f0b06458b14450564f5553, type: 3}
    duration: 12
    startScale: 1.035
    endScale: 1
    startOffset: {x: 0, y: 0}
    endOffset: {x: 0, y: 0}
    subtitle: "\u8FD9\u4E00\u6B21\uFF0C\u6211\u4EEC\u7EC8\u4E8E\u53EF\u4EE5\u9009\u62E9\u81EA\u5DF1\u7684\u660E\u5929\u3002"
    narration: "\u5BF9 SISY \u800C\u8A00\uFF0C\u81EA\u5DF1\u4ECE\u6BD5\u4E1A\u540E\u5C31\u5165\u804C\u7684\u516C\u53F8\uFF0C\u966A\u4F34\u81EA\u5DF1\u591A\u5E74\u7684\u540C\u4E8B\uFF0C\u751A\u81F3\u53EF\u4EE5\u79F0\u4E4B\u4E3A\u4F19\u4F34\u7684\u9A6C\u8001\u677F\u548C
      THANE \u7ADF\u7136\u8D70\u4E0A\u7684\u662F\u8FD9\u6761\u4E0D\u5F52\u8DEF\u3002\u8BE5\u8BF4\u81EA\u5DF1\u662F\u806A\u660E\u8FD8\u662F\u7B28\u5462\uFF0C\u6216\u8BB8\u662F\u90A3\u80A1\u52AA\u529B\u4E0A\u8FDB\u7684\u86EE\u52B2\u8BA9\u5B83\u53EA\u987E\u5F97\u63A8\u52A8\u773C\u524D\u540D\u4E3A\u5DE8\u77F3\u7684\u5DE5\u4F5C\u5427\uFF0C\u53EA\u662F\u4ECE\u4ECA\u5929\u5F00\u59CB\uFF0C\u8FD9\u5757\u7855\u5927\u7684\u5DE8\u77F3\u7EC8\u4E8E\u987A\u7740\u7EC6\u7F1D\u88C2\u5F00\u4E86\u3002\n\n\u5728
      SISY \u8D70\u795E\u7684\u77AC\u95F4\uFF0C\u5176\u4F59\u4E94\u540D\u4F19\u4F34\u63A8\u6421\u4E86\u5B83\u7684\u80CC\u3002\u90A3\u4E00\u523B\uFF0CSISY
      \u4E0D\u7531\u5F97\u8E09\u8DC4\u4E86\u4E00\u4E0B\uFF0C\u5B83\u5FC3\u91CC\u82E6\u7B11\u9053\u201C\u96BE\u9053\u8FD9\u5C31\u662F\u751F\u6D3B\u7684\u63A8\u80CC\u611F\u5417\uFF1F\u201D\u3002\u6709\u53EA\u6E29\u6696\u7684\u624B\u8F7B\u8F7B\u5730\u629A\u4E0A\uFF0C\u575A\u5B9A\u5730\u63E1\u4E0A\u5B83\u7684\u624B\u65F6\uFF0C\u5B83\u62AC\u5934\u770B\u5411\u8EAB\u8FB9\u72FC\u548C\u773C\u524D\u6253\u95F9\u7684\u4F19\u4F34\u4EEC\uFF0C\u5FC3\u91CC\u4E0D\u518D\u611F\u5230\u4E0D\u5B89\u548C\u5BB3\u6015\u3002\n\n\u8FD9\u4E00\u523B\uFF0CSISY
      \u7EC8\u4E8E\u4E0D\u662F\u88AB\u63A8\u7740\u8D70\u4E86\u3002"

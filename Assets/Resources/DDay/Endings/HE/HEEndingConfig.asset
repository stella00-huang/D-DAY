  - id: HE_02_Consequences
    image: {fileID: 2800000, guid: b8380829f3d39eb4e8cee514c7e7d7eb, type: 3}
    duration: 10
    startScale: 1.04
    endScale: 1
    startOffset: {x: -0.01, y: 0}
    endOffset: {x: 0, y: 0}
    subtitle: "\u8FD9\u4E00\u6B21\uFF0C\u4F5C\u6076\u8005\u7EC8\u4E8E\u4ED8\u51FA\u4E86\u4EE3\u4EF7\u3002"
    narration: "\u5728\u6545\u4E8B\u7684\u7ED3\u5C3E\uFF0C\u9A6C\u8001\u677F\u548C
      THANE \u540C\u65F6\u88AB\u8C03\u67E5\u4EBA\u5458\u5E26\u8D70\u3002APIS \u7684\u4E1A\u52A1\u540C\u65F6\u4E5F\u516C\u4E4B\u4E8E\u4F17\u4E86\u3002\u5BF9\u4E8E\u8FD9\u4E2A\u771F\u76F8\uFF0C\u5404\u4F4D\u4F17\u8BF4\u7EB7\u7EAD\uFF0C\u6709\u4EBA\u8BF4\u9A6C\u8001\u677F\u5C31\u662F\u5E55\u540E\u51F6\u624B\uFF0C\u6709\u4EBA\u8BF4\u9A6C\u8001\u677F\u53EA\u662F\u4E2A\u5080\u5121\u3002\u4F46\u8FD9\u4E00\u5207\u7EAD\u7EAD\u968F\u7740\u9A6C\u8001\u677F\u548C
      THANE \u88AB\u5173\u8FDB\u76D1\u72F1\u540E\u5982\u98CE\u4E00\u822C\u90FD\u6D88\u6563\u4E86\u2026\u2026"
    subtitleStart: 7
    subtitleEnd: 9

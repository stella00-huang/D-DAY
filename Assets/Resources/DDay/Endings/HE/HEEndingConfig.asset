    startScale: 1
    endScale: 1.07
    startOffset: {x: 0, y: 0}
    endOffset: {x: -0.004, y: 0.008}
    subtitle: "\u90A3\u4E9B\u88AB\u9690\u85CF\u7684\u79D8\u5BC6\uFF0C\u7EC8\u4E8E\u6709\u4E86\u88AB\u63ED\u5F00\u7684\u673A\u4F1A\u3002"
    narration: "\u81EA\u805A\u9910\u7ED3\u675F\u540E\uFF0CSISY\u3001METIS\u3001CASSIA
      \u6CA1\u65E5\u6CA1\u591C\u5730\u6838\u5BF9\u90A3\u4E9B\u88AB\u9690\u85CF\u7684\u771F\u76F8\u3002\u539F\u6765\uFF0C\u8FD9\u4E00\u9685\u4E4B\u5730\u7ADF\u7136\u840C\u751F\u8FC7\u8BB8\u591A\u7F6A\u6076\u7684\u6E90\u6CC9\uFF0C\u800C\u5B83\u4EEC\u4E5F\u5728\u4E0D\u77E5\u4E0D\u89C9\u4E2D\u6210\u4E3A\u4E86\u94FE\u6761\u4E2D\u7684\u4E00\u4EFD\u5B50\u3002X
      \u7559\u4E0B\u7684\u6240\u8C13\u7684\u201C\u9057\u4E66\u201D\u5230\u5E95\u662F\u771F\u5FC3\u60F3\u8981\u63ED\u9732\u8FD9\u72AF\u7F6A\u94FE\u8FD8\u662F\u84C4\u610F\u62A5\u590D
      APIS \u8001\u677F\uFF0C\u7ED3\u679C\u4E5F\u4E0D\u5F97\u800C\u77E5\u4E86\u3002\u5E86\u5E78\u5730\u662F\uFF0CMETIS
      \u613F\u610F\u4E3A\u5176\u5B83\u52A8\u7269\u505A\u62C5\u4FDD\uFF0C\u9664\u4E86
      THANE\uFF0C\u6BD5\u7ADF\u5B83\u786E\u5B9E\u53C2\u4E0E\u4E86\u72AF\u7F6A\u884C\u4E3A\u3002"
    subtitleStart: 7
    subtitleEnd: 9
